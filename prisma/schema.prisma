generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum ActStatus {
    draft
    generating
    ready
    failed
}

enum ProjectStatus {
    active
    archived
}

enum EstimateStatus {
    draft
    agreed
}

enum EstimateCategory {
    WORK
    MATERIAL
    MACHINERY
    DELIVERY
    TAX
}

enum OrganizationRole {
    OWNER
    MEMBER
}

model User {
    id        String   @id @default(uuid())
    name      String
    email     String?  @unique
    phone     String?
    avatarUrl String?
    createdAt DateTime @default(now())

    memberships OrganizationMember[]
    acts        Act[]
}

model Organization {
    id             String   @id @default(uuid())
    name           String
    edrpou         String?
    representative String?
    avatarUrl      String?
    createdAt      DateTime @default(now())

    members  OrganizationMember[]
    clients  Client[]
    acts     Act[]
    projects Project[]
}

model OrganizationMember {
    id   String           @id @default(uuid())
    role OrganizationRole @default(OWNER)

    userId String
    user   User   @relation(fields: [userId], references: [id])

    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id])

    @@unique([userId, organizationId])
    @@index([organizationId])
}

model Client {
    id String @id @default(uuid())

    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id])

    name        String
    edrpou      String?
    contactName String?
    phone       String?
    email       String?
    avatarUrl   String?

    createdAt DateTime @default(now())

    acts              Act[]
    primaryOnProjects Project[] @relation("ProjectPrimaryClient")

    @@index([organizationId])
}

model Project {
    id String @id @default(uuid())

    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id])

    primaryClientId String?
    primaryClient   Client? @relation("ProjectPrimaryClient", fields: [primaryClientId], references: [id])

    name        String
    address     String?
    description String?
    status      ProjectStatus @default(active)

    plannedStartDate DateTime?
    plannedEndDate   DateTime?

    createdAt DateTime @default(now())

    acts     Act[]
    estimate Estimate?

    @@index([organizationId])
    @@index([primaryClientId])
}

model Estimate {
    id String @id @default(uuid())

    projectId String  @unique
    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    revisions EstimateRevision[]
}

model EstimateRevision {
    id String @id @default(uuid())

    estimateId String
    estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

    version Int
    status  EstimateStatus @default(draft)

    createdAt DateTime @default(now())

    items EstimateItem[]

    @@unique([estimateId, version])
    @@index([estimateId])
}

model EstimateItem {
    id String @id @default(uuid())

    revisionId String
    revision   EstimateRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

    category EstimateCategory @default(WORK)

    name     String
    unit     String
    quantity Decimal @db.Decimal(14, 3)
    price    Decimal @db.Decimal(14, 2)
    amount   Decimal @db.Decimal(14, 2)

    /// Джерело ціни: прайс/КП/рахунок тощо.
    source     String?   @db.VarChar(255)
    /// Дата актуальності джерела ціни.
    sourceDate DateTime?
    /// Довільні уточнення по позиції (склад операції, умови, комплектність тощо).
    note       String?

    order Int @default(0)

    @@index([revisionId])
    @@index([revisionId, category])
}

model Act {
    id String @id @default(uuid())

    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id])

    userId String
    user   User   @relation(fields: [userId], references: [id])

    clientId String?
    client   Client? @relation(fields: [clientId], references: [id])

    projectId String?
    project   Project? @relation(fields: [projectId], references: [id])

    clientSnapshot Json

    /// full ActDocument (items, totals, meta, etc)
    data Json

    templateVersion String
    status          ActStatus @default(draft)

    createdAt DateTime @default(now())

    pdfs ActPdf[]

    @@index([organizationId])
    @@index([userId])
    @@index([clientId])
    @@index([projectId])
}

model ActPdf {
    id String @id @default(uuid())

    actId String
    act   Act    @relation(fields: [actId], references: [id])

    templateVersion String
    checksum        String
    fileUrl         String
    size            Int

    generatedAt DateTime @default(now())

    @@index([actId])
}
